# Stable input to scripts/reference/publish_shakespeare_small.sh.
# This file is data, not shell: the publisher parses each named key instead of
# sourcing it. Changing any value creates a different reference model recipe.

recipe_version = 1
reference_id = shakespeare-small-v1
corpus_manifest = data/corpora/gutenberg-shakespeare-100.manifest
compiler = gcc
seed = 1
vocab_size = 260
embedding_dim = 32
num_heads = 4
num_layers = 2
max_seq_len = 64
train_window = 64
train_stride = 64
epochs = 1
batch_size = 16
gradient_accumulation = 1
learning_rate = 0.001
optimizer = adam
dropout = 0.0
grad_clip = 1.0
weight_decay = 0.01
warmup_steps = 0
total_steps = 0
eval_window = 64
metric_absolute_tolerance = 0.000100
