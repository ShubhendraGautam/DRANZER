# Build artifacts
# src/ is split into core/, backends/{gpu,tpu}/, cli/, tools/ - **/*.o
# catches object files at any depth under those, not just top-level.
src/**/*.o
# Header dependency files written beside each .o by the Makefile's -MMD -MP.
src/**/*.d
src/bench.out
src/bench_profile.out
src/gpu_probe.out
src/gpu_latency.out
src/bench_parallel.out
src/bench_quant.out
src/bench_attention.out
src/fingerprint_model.out
src/app.out
src/libdranzer.a
src/libdranzer.so
src/.public-build/
src/examples/*.out
libs/src/*.o
libs/src/*.d
libs/libattention.a
build/
dist/

# Top-level corpus data only - NOT src/tests/ (test source code, tracked).
# Anchored with a leading slash so it doesn't also match src/tests/.
/tests/

# Probed-machine capability cache - hardware-specific, regenerated per run.
src/gpu_capability_cache/

# Benchmark results log - accumulates across runs on THIS machine; numbers
# aren't comparable across different hardware, so not tracked by default.
# Remove this line if you want to commit a specific machine's history.
# Generated measurement output. Machine-specific and regenerable, same reasoning
# as the results CSVs below: a number measured on one laptop is evidence about
# that laptop, and committing it invites a reader to compare it with theirs.
# scripts/repro/*.sh writes here; docs/reproducibility.md and docs/results.md
# name the command rather than carrying the output.
docs/generated/

bench_results*.csv
matmul_results*.csv
parallel_results*.csv
quant_results*.csv
bundle_load_results*.csv
perf.data*

# Generated files
*.pth
*.tokenizer
*.ckpt
dranzer.pth
checkpoints/

# Logs and outputs
logs.txt
model_output.txt
.train_log.txt
.test_log.txt

# OS files
.DS_Store
*.swp
*.swo
*~

# Editor settings
.vscode/
.idea/
*.iml

# Temporary files
*.tmp
.tmp
